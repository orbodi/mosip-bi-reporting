{
  "name": "bi-cdc-regprc-dev",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "mosip-sim",
    "database.port": "5432",
    "database.dbname": "mosip_regprc",
    "database.user": "${env:MOSIP_CDC_UTILISATEUR}",
    "database.password": "${env:MOSIP_CDC_MOT_DE_PASSE}",
    "database.sslmode": "require",
    "topic.prefix": "mosip.dev",
    "plugin.name": "pgoutput",
    "slot.name": "bi_cdc_regprc_dev",
    "slot.drop.on.stop": "false",
    "publication.name": "bi_cdc_regprc",
    "publication.autocreate.mode": "disabled",
    "table.include.list": "regprc.registration",
    "column.include.list": "regprc.registration.(id|reg_type|status_code|latest_trn_type_code|latest_trn_status_code|latest_trn_dtimes|reg_stage_name|pkt_cr_dtimes|is_active|cr_dtimes|upd_dtimes|is_deleted)",
    "snapshot.mode": "initial",
    "tombstones.on.delete": "true",
    "skipped.operations": "t",
    "decimal.handling.mode": "string",
    "time.precision.mode": "adaptive",
    "heartbeat.interval.ms": "10000",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "errors.tolerance": "none",
    "errors.log.enable": "true",
    "errors.log.include.messages": "false"
  }
}
