      "credentials": [{ "type": "password", "value": "dev-bi-national", "temporary": false }],
      "realmRoles": ["bi-national"]
    },
    {
      "username": "savanes.test",
      "enabled": true,
      "firstName": "Agent",
      "lastName": "Savanes",
      "email": "savanes.test@example.invalid",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "dev-bi-savanes", "temporary": false }],
      "realmRoles": ["bi-regional"]
    }
  ]
