# Copier en .env.local et adapter. Ne jamais committer de .env.local.
# Connexion Keycloak (désactivée par défaut en développement)
VITE_AUTH_ACTIVE=false
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=anid
VITE_KEYCLOAK_CLIENT=bi-reporting
# Base de l'API si elle n'est pas servie sur la même origine (vide = même origine)
VITE_API_URL=
